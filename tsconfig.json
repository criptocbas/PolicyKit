{
  "compilerOptions": {
    "types": ["mocha", "chai"],
    "typeRoots": ["./node_modules/@types"],
    "lib": ["ES2020"],
    "module": "commonjs",
    "target": "ES2020",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@policykit/sdk": ["packages/sdk/src"],
      "@policykit/agent-kit-plugin": ["packages/agent-kit-plugin/src"]
    }
  },
  "include": ["tests/**/*", "packages/**/src/**/*"]
}
