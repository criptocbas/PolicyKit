{
  "name": "@policykit/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the PolicyKit on-chain policy engine",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
