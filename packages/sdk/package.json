    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": "^0.32.0",
    "@solana/web3.js": "^1.95.0"
  }
