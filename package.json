{
  "name": "policykit",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build:packages": "yarn workspace @policykit/sdk build && yarn workspace @policykit/agent-kit-plugin build",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "test": "yarn build:packages && anchor test",
    "test:unit": "yarn workspace @policykit/sdk test",
    "test:integration": "yarn build:packages && anchor test",
    "typecheck:packages": "yarn workspace @policykit/sdk build && yarn workspace @policykit/agent-kit-plugin build",
    "typecheck:dashboard": "yarn workspace @policykit/dashboard exec tsc --noEmit",
    "ci:local": "yarn typecheck:packages && yarn test:unit && yarn test:integration",
    "verify:fast": "yarn test:unit && yarn build:packages && yarn typecheck:x402 && yarn build:dashboard && cargo test -p policykit --lib",
    "build:dashboard": "yarn build:packages && yarn workspace @policykit/dashboard build",
    "dev:dashboard": "yarn workspace @policykit/dashboard dev",
    "build": "yarn build:packages && yarn workspace @policykit/dashboard build",
    "deploy:devnet": "bash scripts/deploy-devnet.sh",
    "demo:devnet": "yarn build:packages && ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/devnet-live-demo.ts",
    "agent:setup": "yarn build:packages && ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/live-agent/setup-live-policy.ts",
    "agent:tick": "yarn build:packages && ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/live-agent/run-tick.ts",
    "agent:cron": "bash scripts/live-agent/install-cron.sh",
    "agent:systemd": "bash scripts/live-agent/install-systemd.sh",
    "agent:health": "bash scripts/live-agent/feed-health.sh",
    "example:agent-kit": "yarn build:packages && yarn workspace @policykit/example-agent-kit-bounded-spend start",
    "example:x402": "yarn build:packages && yarn workspace @policykit/example-x402-policykit start",
    "typecheck:x402": "yarn build:packages && yarn workspace @policykit/example-x402-policykit typecheck"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
